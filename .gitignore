# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# MicroPython type stubs for Pylance, installed by `./tools/pico stubs`.
# ~1.3 MB of regenerable .pyi files, so not committed.
typings/

# Left over from the old extension-managed stub layout; safe to delete.
.vscode/Pico-W-Stub/

# UF2 artifacts produced by `./tools/pico build` / `./tools/pico uf2`, plus the
# stock MicroPython firmware `./tools/pico firmware` caches in build/firmware.
# All re-downloadable or rebuildable, so none of it is committed.
build/*
!build/.gitkeep

# The user program that main.py writes to flash at runtime; not source.
/program.py

docs/*.json
